{
  "name": "DataSource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the data source"
    },
    "type": {
      "type": "string",
      "enum": [
        "github",
        "slack",
        "sentry",
        "metrics",
        "custom_api",
        "pagerduty",
        "datadog",
        "jira",
        "linear"
      ],
      "description": "Type of data source"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error",
        "syncing"
      ],
      "default": "disconnected"
    },
    "config": {
      "type": "object",
      "description": "Connection configuration (endpoint, auth type, etc.)"
    },
    "last_sync": {
      "type": "string",
      "format": "date-time"
    },
    "record_count": {
      "type": "number",
      "default": 0
    },
    "schema_fields": {
      "type": "array",
      "description": "Fields exposed as SQL columns",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "type"
  ]
}
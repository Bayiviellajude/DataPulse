{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "e.g. incident.created, source.synced, query.executed"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "ip_address": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "failed"
      ],
      "default": "success"
    }
  },
  "required": [
    "action",
    "actor_email"
  ]
}
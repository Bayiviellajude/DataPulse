{
  "name": "CommunityPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "question",
        "discussion"
      ],
      "default": "question"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "upvotes": {
      "type": "number",
      "default": 0
    },
    "answer_count": {
      "type": "number",
      "default": 0
    },
    "is_answered": {
      "type": "boolean",
      "default": false
    },
    "views": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "body",
    "author_email"
  ]
}